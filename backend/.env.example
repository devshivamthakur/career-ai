# ═══════════════════════════════════════════════════════════════════════
# Environment Configuration Example
# Copy this file to .env and fill in your actual values
# ═══════════════════════════════════════════════════════════════════════

# APPLICATION ENVIRONMENT
ENVIRONMENT=development
# Options: development, staging, production

# DATABASE
DATABASE_URL=postgresql://user:password@localhost:5432/carerai

# REDIS CACHE
REDIS_URL=redis://localhost:6379

# OPENAI API
OPENAI_API_KEY=sk-your-api-key-here
# OPENAI_BASE_URL=https://api.openai.com/v1  # Optional, for custom endpoints

# LLM PROVIDER
LLM_PROVIDER=openai  # or aws

AWS Bedrock (Optional, required when LLM_PROVIDER=aws)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_SESSION_TOKEN=your-aws-session-token
AWS_CREDENTIALS_PROFILE_NAME=your-aws-profile-name
AWS_MODEL_PROVIDER=mistral
FAST_MODEL_NAME=mistral.voxtral-mini-3b-2507

# LANGFUSE (Optional - for logging and monitoring)
LANGFUSE_PUBLIC_KEY=your-public-key
LANGFUSE_SECRET_KEY=your-secret-key
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# HUGGINGFACE (Optional - for embeddings)
HUGGINGFACE_API_TOKEN=hf_your-token-here

# ═══════════════════════════════════════════════════════════════════════
# SECURITY & CORS CONFIGURATION
# ═══════════════════════════════════════════════════════════════════════

# Allowed origins for CORS - comma-separated list of URLs
# DEVELOPMENT: http://localhost:5173,http://localhost:3000
# PRODUCTION: https://yourfrontend.com,https://www.yourfrontend.com
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Hide Swagger/OpenAPI documentation in production
# Set to True for production to hide /docs and /redoc endpoints
HIDE_DOCS_IN_PRODUCTION=False
# For production: HIDE_DOCS_IN_PRODUCTION=True

# Enable security headers (X-Frame-Options, CSP, HSTS, etc.)
ENABLE_SECURITY_HEADERS=True

# Optional API Key for additional authentication
# API_KEY=your-secret-api-key-here

# ═══════════════════════════════════════════════════════════════════════
# MODEL CONFIGURATION
# ═══════════════════════════════════════════════════════════════════════

# Fast model for quick operations
FAST_MODEL_NAME=poolside/laguna-xs.2

# Quality model for detailed analysis
QUALITY_MODEL_NAME=poolside/laguna-m.1

# Embedding model for semantic search
EMBEDDING_MODEL_REPO_ID=BAAI/bge-base-en-v1.5
