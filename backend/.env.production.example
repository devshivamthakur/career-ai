# =============================================================================
#  CareerAI Backend — Production Environment Variables
# =============================================================================
#  Copy this file to .env.production and fill in your values:
#    cp .env.production.example .env.production
# =============================================================================

# ─── Docker Registry ───────────────────────────────────────────────────────
# Option A: Docker Hub
DOCKER_USERNAME=your-dockerhub-username
DOCKER_PASSWORD=your-dockerhub-password-or-token

# Option B: AWS ECR (uncomment and use instead of Docker Hub)
# AWS_ACCOUNT_ID=123456789012
# AWS_REGION=us-east-1

# ─── AWS EC2 ───────────────────────────────────────────────────────────────
EC2_HOST=ec2-xx-xx-xx-xx.compute-1.amazonaws.com
EC2_USER=ubuntu
EC2_SSH_KEY=~/.ssh/careerai-ec2.pem

# ─── Database ──────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@your-rds-endpoint:5432/careerai

# ─── Redis (ElastiCache or self-hosted) ────────────────────────────────────
REDIS_URL=redis://your-redis-endpoint:6379

# ─── LLM / AI Provider ────────────────────────────────────────────────────
OPENAI_API_KEY=sk-your-openai-api-key
# OPENAI_BASE_URL=https://your-custom-openai-proxy.com/v1  # optional

LLM_PROVIDER=openai
FAST_MODEL_NAME=poolside/laguna-xs.2
QUALITY_MODEL_NAME=poolside/laguna-m.1

# ─── AWS Bedrock (alternative LLM provider) ────────────────────────────────
# AWS_ACCESS_KEY_ID=AKIAxxxxxxxxxxxxxxxx
# AWS_SECRET_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# AWS_MODEL_PROVIDER=mistral

# ─── Observability (LangFuse) ─────────────────────────────────────────────
# LANGFUSE_PUBLIC_KEY=pk-lf-xxxxx
# LANGFUSE_SECRET_KEY=sk-lf-xxxxx
# LANGFUSE_BASE_URL=https://cloud.langfuse.com

# ─── Hugging Face (Embeddings for semantic cache) ─────────────────────────
# HUGGINGFACE_API_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── CORS ──────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=https://your-frontend-domain.com

# ─── Deployment Behavior ──────────────────────────────────────────────────
RUN_MIGRATIONS_ON_DEPLOY=true
